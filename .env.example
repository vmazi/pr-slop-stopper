# PR Slop Stopper Environment Variables
# Copy this file to .env and fill in the values

# GitHub App Configuration
# Get these from your GitHub App settings at https://github.com/settings/apps
GITHUB_APP_ID=your_app_id
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# GitHub App Private Key
# Paste the contents of your .pem file here (with newlines replaced by \n)
# Or use a file path: GITHUB_PRIVATE_KEY_FILE=/path/to/key.pem
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
